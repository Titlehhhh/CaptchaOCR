# Build output
build/
target/
*.class

# The CUDA training environment - 5 GB, and it is reinstalled with one command
.venv-gpu/
.venv/
__pycache__/
*.py[cod]

# Training runs: checkpoints, logs, contact sheets
train/run/
train/run_ppocr/
train/*/ckpt/
*.pt
*.pth
*.onnx

# The Hugging Face model cache: several GB of downloaded weights, re-downloadable
.hf-cache/

# Machine-local environment of this project (paths of this computer, may hold secrets).
# Read by DeepSeek Harness at launch; the project copy sits next to the repo.
.env

# The dataset images live on Hugging Face, not in git (ADR 0004). 23 000 PNG = 218 MB;
# the git history keeps every revision forever, so the payload does not belong here.
# The labels, the generators and the per-type samples under dataset/samples/ stay tracked.
dataset/out/**/*.png
dataset/out_ru/**/*.png

# Where tools/fetch_dataset.py puts the full dataset it pulls from Hugging Face
dataset/full/

# Scratch
tmp/
*.log
.DS_Store
Thumbs.db

# Upstream binaries and decompiler output: large, re-downloadable, and the extracted
# BotFilter reference shots are no longer published (they live on disk only, see ADR 0004)
research/cfr.jar
research/cvz*/
research/jars/
research/decompiled/
research/__pycache__/
research/tools/__pycache__/

# AGPL-3.0 decompilation of Elytrium/LimboFilter (upstream headers intact). Not
# redistributable in this repository: the plugin is open, its sources are not ours.
# Kept on disk only - see research/README.md.
research/limbofilter/

# Output of research/DiffCaptchaVerifyZ.java - byte-identical to research/refout/
research/myout/

# A 3.3 MB sitemap of a forum, kept as a link instead
research/spigotmcru_sitemap.xml

# Stray temp dirs created by tools (not the tmp/ scratch folder)
tmp*/

# Leftovers from tooling: pip build trackers, torch inductor caches, raw frame dumps
pip-*
torchinductor_*
*.raw

# Разметка датасета живёт на Hugging Face (внутри parquet), в git не нужна
dataset/out/**/labels.jsonl
dataset/out_ru/**/labels.jsonl

# Одноразовая проверочная выборка из отдельного прогона генератора
dataset/eval_fresh/

# Данные прогонов и опубликованные веса - на диске и на HF, не в git
train/runs/
train/published/

# The gallery thumbnails are a derived output of reports/HTML/make_gallery.py
# (copies of dataset pictures, which live on Hugging Face - ADR 0004).
reports/HTML/img/t/**/*.png
